# Default deny: development docs, private data, outputs and environments stay local.
*
!/.gitignore

# Only runtime source code and its required configuration/notices are eligible.
!/src/
!/src/sno2md/
!/src/sno2md/*.py
!/src/desktop/
!/src/desktop/launcher.py
!/src/convert_sdocx.py
!/src/requirements.txt
!/src/third_party/
!/src/third_party/pypdf-LICENSE.txt
# Allow attachments
!/attachments/
!/attachments/*

# Generated Python files are never source.
**/__pycache__/
*.py[cod]

#credentials    
.env 


!/README.md
# Installable conversion package metadata
!/src/pyproject.toml

# Optional Markdown font decoding notices
!/src/third_party/fonttools-LICENSE.txt
!/src/third_party/fonttools-LICENSE.external.txt

# Python packaging artifacts
/src/build/
/src/dist/
/src/*.egg-info/

# Local development material and generated artifacts stay outside the public source.
/docs/
/research/
/private/
